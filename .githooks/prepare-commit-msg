#!/usr/bin/env bash
set -euo pipefail

message_file="${1:?commit message file is required}"
source="${2:-}"

# 保留 merge、squash 和用户显式提供的提交信息；Git 默认注释不算正文。
if [[ -n "$source" ]] || awk '!/^[[:space:]]*#/ && NF { found=1 } END { exit !found }' "$message_file"; then
  exit 0
fi

command -v codex >/dev/null 2>&1 || {
  echo "prepare-commit-msg: codex 未找到，跳过自动生成。" >&2
  exit 0
}

repo_root="$(git rev-parse --show-toplevel)"
diff_file="$(mktemp "${TMPDIR:-/tmp}/codex-commit-diff.XXXXXX")"
answer_file="$(mktemp "${TMPDIR:-/tmp}/codex-commit-answer.XXXXXX")"
trap 'rm -f "$diff_file" "$answer_file"' EXIT

git -C "$repo_root" diff --cached --no-ext-diff --unified=1 >"$diff_file"
if [[ ! -s "$diff_file" ]]; then
  echo "prepare-commit-msg: 暂存区没有改动，跳过自动生成。" >&2
  exit 0
fi

prompt_file="$(mktemp "${TMPDIR:-/tmp}/codex-commit-prompt.XXXXXX")"
trap 'rm -f "$diff_file" "$answer_file" "$prompt_file"' EXIT
{
  cat <<'PROMPT'
请根据下面的 Git 暂存区 diff 生成一条中文 Git 提交信息。

要求：
1. 第一行使用祈使句，概括主要变更，20 个汉字以内；
2. 可选地在第二行留空后补充 1-3 条简短说明；
3. 只输出提交信息正文，不要 Markdown 代码块、标题前缀或解释；
4. 不要虚构 diff 中不存在的改动。

暂存区 diff：
PROMPT
  cat "$diff_file"
} >"$prompt_file"

if ! codex exec \
  --ephemeral \
  --sandbox read-only \
  --cd "$repo_root" \
  --output-last-message "$answer_file" \
  - <"$prompt_file" >/dev/null 2>&1; then
  echo "prepare-commit-msg: Codex 生成失败，保留空白消息供手动填写。" >&2
  exit 0
fi

if [[ ! -s "$answer_file" ]]; then
  echo "prepare-commit-msg: Codex 未返回提交信息，保留手动编辑。" >&2
  exit 0
fi

# 去除 Codex 偶尔返回的代码围栏。
sed -e '/^[[:space:]]*```[[:alnum:]_-]*[[:space:]]*$/d' \
    -e '/^[[:space:]]*```[[:space:]]*$/d' "$answer_file" >"$message_file"
echo "prepare-commit-msg: 已生成候选提交信息，请在编辑器中确认或修改。" >&2
