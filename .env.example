# Required for LLM-backed agents and the KGCC/KADS pipeline.
MEDIX_LLM_API_KEY=
MEDIX_LLM_MODEL=qwen3.8-max
MEDIX_LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
MEDIX_LLM_TEMPERATURE=0.7
MEDIX_LLM_MAX_TOKENS=8192

# Optional. Long-term memory degrades gracefully when unset.
MEM0_API_KEY=

# Persistence
MEDIX_DB_PATH=data/medix.db
MEDIX_REDIS_URL=redis://localhost:6379/0

# Embedding model download/cache (Docker persists this cache in the hf_cache volume)
MEDIX_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# Equal-quota corpora used by source-balanced retrieval.
MEDIX_KB_SOURCE_TYPES=clinical_guideline,drug_label,textbook,research,standard,document,unclassified
MEDIX_RETRIEVAL_PER_SOURCE=3
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DOWNLOAD_TIMEOUT=120
HF_HUB_ETAG_TIMEOUT=120

# 网络搜索 / 容器 DNS。若服务器只能通过代理访问外网，请填写代理地址。
MEDIX_DNS_PRIMARY=223.5.5.5
MEDIX_DNS_SECONDARY=119.29.29.29
MEDIX_DNS_FALLBACK=1.1.1.1
MEDIX_WEB_SEARCH_TIMEOUT=8
MEDIX_WORKER_TIMEOUT=180
MEDIX_MEDRGAG_TIMEOUT=120
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
